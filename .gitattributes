# Normalize line endings: LF in the repository, native in the working tree.
* text=auto

# Always LF — these are read by tools that dislike CRLF.
*.js      text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
.env.example text eol=lf
.gitignore   text eol=lf

# Binary.
*.png     binary
*.jpg     binary
*.ico     binary
