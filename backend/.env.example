# Copy to backend/.env (or run: npm --prefix backend run setup:env) and fill in real values.
# Placeholders only - never commit real credentials.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Platform MongoDB (local simulation) -------------------------------------------------------
# Administrative/provisioning identity (seeding, workspaces, users, attempts, audit logs).
MONGODB_ADMIN_URI=mongodb://127.0.0.1:27017
# Docker Compose (auth enabled):
# MONGODB_ADMIN_URI=mongodb://practice_admin:<password>@127.0.0.1:27017/?authSource=admin
# Optional separate, lower-privileged identity for student query execution.
MONGODB_QUERY_URI=
# true = create one MongoDB user per workspace with readWrite on that database only
# (requires a MongoDB with authentication enabled, e.g. the Docker Compose setup).
WORKSPACE_DB_USERS=false
APP_DB_NAME=practice_platform
TEMPLATE_DB_NAME=mongodb_practice
WORKSPACE_DB_PREFIX=mp_ws_

# --- Security ------------------------------------------------------------------------------------
# At least 32 random characters.
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=8h
# 64 hex characters (32 bytes). Encrypts stored Atlas connection strings.
CREDENTIAL_ENCRYPTION_KEY=<64-hex-characters>
BCRYPT_ROUNDS=10

# --- Instructor / admin account created by `npm run seed` ----------------------------------------
INSTRUCTOR_NAME=Course Instructor
INSTRUCTOR_EMAIL=instructor@practice.local
# Quote values that contain '#', e.g. INSTRUCTOR_PASSWORD="Pa#ss"
INSTRUCTOR_PASSWORD=<choose-a-strong-password>

# --- Query sandbox limits ------------------------------------------------------------------------
REQUEST_BODY_LIMIT=16kb
QUERY_MAX_LENGTH=4000
QUERY_MAX_RESULTS=100
QUERY_TIMEOUT_MS=3000
QUERY_RATE_LIMIT_PER_MIN=60
AUTH_RATE_LIMIT_PER_MIN=30

# --- Student MongoDB Atlas connections -----------------------------------------------------------
ATLAS_ALLOWED_HOST_SUFFIXES=.mongodb.net
ATLAS_CONNECT_TIMEOUT_MS=8000
ATLAS_IDLE_CLOSE_MS=600000

# --- Optional real-Atlas integration tests (dedicated TEST cluster/database only) ----------------
# ATLAS_TEST_URI=mongodb+srv://<test-user>:<password>@<test-cluster>.mongodb.net/
# ATLAS_TEST_DB=practice_platform_ci

LOG_LEVEL=info
